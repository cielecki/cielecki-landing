---
import { getCollection } from 'astro:content';
import { buildNav } from '../lib/nt-nav';
import { type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Slug of the symptom to highlight (the current page, or a sub-page's parent). */
  activeSlug?: string;
}

const { lang, activeSlug } = Astro.props;
const symptoms = await getCollection('symptoms', (s) => s.data.lang === lang);
const groups = buildNav(symptoms, lang);
---

<nav class="text-sm" aria-label="Tematy">
  {
    groups.map((g) => (
      <div class="mb-5" data-conditions={g.conditions.join(' ')}>
        <div class="px-3 mb-1.5 text-[11px] font-semibold uppercase tracking-wider text-charcoal-light/45">
          {g.label}
        </div>
        <ul class="space-y-0.5">
          {g.items.map((it) => {
            const active = it.slug === activeSlug;
            return (
              <li data-conditions={it.conditions.join(' ')}>
                <a
                  href={`/nt/${lang}/symptom/${it.slug}/`}
                  aria-current={active ? 'page' : undefined}
                  class={`flex items-start gap-2.5 px-3 py-1.5 rounded-lg leading-snug transition-colors ${
                    active
                      ? 'bg-terracotta/12 text-terracotta-dark font-semibold'
                      : 'text-charcoal-light hover:bg-white/70 hover:text-charcoal-dark'
                  }`}
                >
                  <span class="iconify flex-shrink-0 mt-0.5 text-base opacity-70" data-icon={it.icon} />
                  <span class="min-w-0">{it.title}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
