---
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';
import { sourcesLabel, sourceTier } from '../lib/signals';

interface Props {
  evidence: string;
  /** Count of independent sources backing the method (computed from resources). */
  sources: number;
  lang: Lang;
}

const { evidence, sources, lang } = Astro.props;
const t = useTranslations(lang);

const evClass: Record<string, string> = {
  A: 'bg-sage/30 text-sage-dark',
  B: 'bg-sage/18 text-sage-dark',
  C: 'bg-sand/45 text-charcoal-light',
  D: 'bg-charcoal/8 text-charcoal-light/70',
};
const srcClass: Record<string, string> = {
  high: 'bg-terracotta/22 text-terracotta-dark',
  mid: 'bg-terracotta/12 text-terracotta-dark',
  low: 'bg-charcoal/8 text-charcoal-light/70',
};
const tier = sourceTier(sources);
---

<div class="flex flex-wrap items-center gap-2">
  <span
    class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${evClass[evidence] ?? ''}`}
    title={t('nt.evidence')}
  >
    <span class="iconify text-sm" data-icon="mdi:flask-outline"></span>
    {t(`ev.${evidence}` as UIKey)}
  </span>
  {sources > 0 && (
    <span
      class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${srcClass[tier]}`}
      title={t('nt.sourcesHint')}
    >
      <span class="iconify text-sm" data-icon="mdi:account-voice"></span>
      {sourcesLabel(sources, lang)}
    </span>
  )}
</div>
