---
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';
import { sourcesLabel, sourceTier, evidenceClass, evidenceMutedClass } from '../lib/signals';

interface Props {
  evidence: string;
  /** Count of independent sources backing the method (computed from resources). */
  sources: number;
  lang: Lang;
  /** No direct studies behind this grade → render greyed ("unverified estimate"). */
  muted?: boolean;
  /** If set, the evidence badge becomes a link (e.g. "#badania" to jump to the studies). */
  href?: string;
  /** Hide the source-count badge (e.g. when the count is shown once in a section header). */
  hideSources?: boolean;
}

const { evidence, sources, lang, muted = false, href, hideSources = false } = Astro.props;
const t = useTranslations(lang);

const srcClass: Record<string, string> = {
  high: 'bg-terracotta/22 text-terracotta-dark',
  mid: 'bg-terracotta/12 text-terracotta-dark',
  low: 'bg-charcoal/8 text-charcoal-light/70',
};
const tier = sourceTier(sources);

// Greyed when unverified; otherwise the monotonic A→D scale.
const evColour = muted ? evidenceMutedClass : (evidenceClass[evidence] ?? '');
// Tooltip: explain THIS grade (or that it's a preliminary estimate).
const evTitle = muted ? t('nt.evidenceUnverified') : t(`evExplain.${evidence}` as UIKey);
const evBase = `inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${evColour}`;
---

<div class="flex flex-wrap items-center gap-2">
  {href ? (
    <a class={`${evBase} cursor-pointer hover:brightness-95 transition`} href={href} title={evTitle}>
      <span class="iconify text-sm" data-icon="mdi:flask-outline"></span>
      {t(`ev.${evidence}` as UIKey)}
      <span class="iconify text-xs opacity-60" data-icon="mdi:chevron-down"></span>
    </a>
  ) : (
    <span class={`${evBase} cursor-help`} title={evTitle}>
      <span class="iconify text-sm" data-icon="mdi:flask-outline"></span>
      {t(`ev.${evidence}` as UIKey)}
    </span>
  )}
  {sources > 0 && !hideSources && (
    <span
      class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium ${srcClass[tier]}`}
      title={t('nt.sourcesHint')}
    >
      <span class="iconify text-sm" data-icon="mdi:account-voice"></span>
      {sourcesLabel(sources, lang)}
    </span>
  )}
</div>
