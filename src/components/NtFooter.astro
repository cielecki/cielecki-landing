---
import { getCollection } from 'astro:content';
import { buildNav } from '../lib/nt-nav';
import { useTranslations, otherLang, languageNames, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** URL of the equivalent page in the other language (for the switcher). */
  altLangUrl: string;
}

const { lang, altLangUrl } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const home = `/nt/${lang}/`;

const symptoms = await getCollection('symptoms', (s) => s.data.lang === lang);
const groups = buildNav(symptoms, lang);
---

<footer class="relative z-10 border-t border-charcoal/8 mt-16 bg-white/40 backdrop-blur">
  <div class="max-w-6xl mx-auto w-full px-6 py-12">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,18rem)_1fr]">
      <!-- brand + about -->
      <div>
        <a href={home} class="group inline-flex items-center gap-2.5 mb-3">
          <span class="iconify text-terracotta-dark text-2xl" data-icon="mdi:brain"></span>
          <span class="font-serif text-lg font-bold text-charcoal-dark group-hover:text-terracotta-dark transition-colors">
            Neuro Toolkit
          </span>
        </a>
        <p class="text-sm text-charcoal-light/80 leading-relaxed max-w-sm">{t('footer.aboutText')}</p>
        <a
          href={altLangUrl}
          class="mt-4 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-charcoal/10 bg-white/60 text-sm font-medium text-charcoal-light hover:bg-white hover:text-terracotta-dark transition-all"
          title={languageNames[other]}
        >
          <span class="iconify text-base" data-icon="mdi:translate"></span>
          {other.toUpperCase()} — {languageNames[other]}
        </a>
      </div>

      <!-- site map: every symptom grouped by theme -->
      <nav aria-label={t('footer.sitemap')}>
        <div class="flex items-baseline justify-between gap-3 mb-4 pb-2 border-b border-charcoal/8">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/55">{t('footer.sitemap')}</h2>
          <a href={home} class="text-xs text-charcoal-light/55 hover:text-terracotta-dark transition-colors">
            {t('footer.allTopics')} →
          </a>
        </div>
        <div class="grid gap-x-8 gap-y-5 sm:grid-cols-2 lg:grid-cols-3">
          {groups.map((g) => (
            <div data-conditions={g.conditions.join(' ')}>
              <div class="text-[11px] font-semibold uppercase tracking-wider text-charcoal-light/45 mb-1.5">{g.label}</div>
              <ul class="space-y-1">
                {g.items.map((it) => (
                  <li data-conditions={it.conditions.join(' ')}>
                    <a
                      href={`/nt/${lang}/symptom/${it.slug}/`}
                      class="text-sm text-charcoal-light hover:text-terracotta-dark transition-colors leading-snug"
                    >
                      {it.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </nav>
    </div>

    <div class="mt-10 pt-6 border-t border-charcoal/8 flex flex-col sm:flex-row sm:items-center gap-3 sm:justify-between">
      <p class="text-xs text-charcoal-light/65 leading-relaxed max-w-2xl">{t('footer.disclaimer')}</p>
      <a href="/" class="text-xs text-charcoal-light/55 hover:text-terracotta-dark transition-colors flex-shrink-0">cielecki.com</a>
    </div>
  </div>
</footer>
