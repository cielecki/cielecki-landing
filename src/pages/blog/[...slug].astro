---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
---

<BaseLayout title={`${post.data.title} - Maciej Cielecki`} description={post.data.description}>

  <nav class="fixed top-0 left-0 right-0 z-50 bg-cream/80 backdrop-blur-xl border-b border-charcoal/5">
    <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="font-serif text-2xl font-bold italic text-charcoal-dark tracking-tight">MC</a>
      <div class="flex items-center gap-8">
        <a href="/blog" class="text-sm text-charcoal-light hover:text-charcoal transition-colors">
          <iconify-icon icon="solar:arrow-left-linear" class="mr-1"></iconify-icon>
          All posts
        </a>
        <a href="/#contact" class="text-sm px-4 py-2 bg-charcoal-dark text-cream rounded-lg hover:bg-charcoal transition-colors">Get in Touch</a>
      </div>
    </div>
  </nav>

  <main class="pt-32 pb-24 px-6">
    <article class="max-w-2xl mx-auto">
      <header class="mb-12 animate-fade-in-up">
        <time class="text-sm text-charcoal-light/70 font-mono">{formatDate(post.data.date)}</time>
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal-dark mt-3 mb-4 leading-tight">{post.data.title}</h1>
        <p class="text-lg text-charcoal-light leading-relaxed">{post.data.description}</p>

        {post.data.tags && (
          <div class="flex flex-wrap gap-2 mt-5">
            {post.data.tags.map(tag => (
              <span class="text-xs px-2.5 py-1 bg-terracotta/8 text-terracotta-dark rounded-full">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose animate-fade-in-up-d1">
        <Content />
      </div>

      <div class="mt-16 pt-8 border-t border-charcoal/10">
        <a href="/blog" class="inline-flex items-center gap-2 text-terracotta font-semibold hover:gap-3 transition-all">
          <iconify-icon icon="solar:arrow-left-linear"></iconify-icon>
          <span>Back to all posts</span>
        </a>
      </div>
    </article>
  </main>

  <footer class="border-t border-charcoal/8 py-8 px-6">
    <div class="max-w-6xl mx-auto text-center">
      <a href="/" class="font-serif text-lg font-bold italic text-charcoal-dark hover:text-terracotta transition-colors">MC</a>
      <p class="text-sm text-charcoal-light/60 mt-2">&copy; 2026 Maciej Cielecki</p>
    </div>
  </footer>

</BaseLayout>
