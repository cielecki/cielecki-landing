---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Maciej Cielecki">

  <div class="min-h-screen flex flex-col">
  <main class="relative flex-1 flex items-center px-6 py-16 overflow-hidden">
    <div class="absolute top-20 -right-32 w-96 h-96 bg-terracotta/10 blob blur-3xl"></div>
    <div class="absolute -bottom-20 -left-32 w-80 h-80 bg-sage/15 blob blur-3xl"></div>

    <div class="relative z-10 max-w-5xl mx-auto w-full grid lg:grid-cols-[auto_1fr] gap-12 lg:gap-16 items-center">

      <div class="flex justify-center lg:justify-start">
        <div class="relative">
          <div class="absolute -inset-4 rounded-[2rem] border border-terracotta/15 -rotate-3"></div>
          <div class="absolute -inset-8 rounded-[2.5rem] border border-sage/10 rotate-2"></div>
          <img
            src="/images/hero-portrait.jpg"
            alt="Maciej Cielecki"
            class="w-64 sm:w-72 lg:w-80 aspect-square object-cover object-top rounded-2xl shadow-2xl shadow-charcoal/10 relative"
          />
        </div>
      </div>

      <div class="text-center lg:text-left">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.05] text-charcoal-dark mb-6 animate-fade-in-up">
          Maciej <span class="italic text-terracotta-dark">Cielecki</span>
        </h1>

        <p class="text-lg sm:text-xl text-charcoal-light leading-relaxed max-w-xl mx-auto lg:mx-0 mb-10 animate-fade-in-up-d1">
          Builder. Executive Chairman & Chief AI Officer at 10Clouds. 15 years running a 150+ person agency. Obsessively deep in AI &mdash; building things that help people.
        </p>

        <div class="flex flex-wrap gap-3 justify-center lg:justify-start animate-fade-in-up-d2">
          <a href="https://linkedin.com/in/cielecki" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-charcoal-dark font-medium hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <iconify-icon icon="solar:linkedin-bold" class="text-terracotta text-xl"></iconify-icon>
            <span>LinkedIn</span>
          </a>
          <a href="https://x.com/mcielecki" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-charcoal-dark font-medium hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <iconify-icon icon="simple-icons:x" class="text-terracotta text-base"></iconify-icon>
            <span>X / Twitter</span>
          </a>
          <a href="https://github.com/cielecki" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-3 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-charcoal-dark font-medium hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <iconify-icon icon="simple-icons:github" class="text-terracotta text-lg"></iconify-icon>
            <span>GitHub</span>
          </a>
          <a href="mailto:maciej@cielecki.com" class="inline-flex items-center gap-2 px-5 py-3 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-charcoal-dark font-medium hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <iconify-icon icon="solar:letter-bold" class="text-terracotta text-lg"></iconify-icon>
            <span>maciej@cielecki.com</span>
          </a>
        </div>
      </div>

    </div>
  </main>

  <footer class="py-6 px-6 text-center">
    <p class="text-sm text-charcoal-light/60">&copy; 2026 Maciej Cielecki</p>
  </footer>
  </div>

</BaseLayout>
