---
const pageTitle = "Maciej Cielecki - AI Loyalist & Executive Chairman at 10Clouds";
const pageDescription = "Helping professionals organize their entire life with AI, not complex systems.";
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={pageDescription}>
    <title>{pageTitle}</title>

    <!-- Iconify -->
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,400;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Navigation -->
    <nav class="nav">
        <div class="nav-container">
            <a href="#" class="logo">MC</a>
            <div class="nav-links">
                <a href="#about" class="nav-link">About</a>
                <a href="#work" class="nav-link">Work</a>
                <a href="#writing" class="nav-link">Writing</a>
                <a href="#contact" class="nav-link-cta">Get in Touch</a>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-container">
            <div class="hero-badge animate-fade-in">
                <iconify-icon icon="solar:verified-check-bold" class="badge-icon"></iconify-icon>
                <span>AI Loyalist</span>
            </div>

            <h1 class="hero-title animate-fade-in-up">
                Helping overwhelmed professionals
                <span class="gradient-text">organize their entire life</span>
                with AI, not complex systems
            </h1>

            <p class="hero-subtitle animate-fade-in-up">
                Executive Chairman & Chief AI Officer at 10Clouds • 80hrs/week in AI • Built AIConsole •
                15 years running a 150+ person agency
            </p>

            <div class="hero-cta animate-fade-in-up">
                <a href="#contact" class="btn-primary">
                    <span>Start the Conversation</span>
                    <iconify-icon icon="solar:arrow-right-linear" class="btn-icon"></iconify-icon>
                    <div class="beam"></div>
                </a>
                <a href="#work" class="btn-secondary">
                    <iconify-icon icon="solar:play-circle-bold" class="btn-icon-left"></iconify-icon>
                    <span>See My Work</span>
                </a>
            </div>

            <div class="container-lines"></div>
        </div>

        <div class="grid-background"></div>
    </section>

    <!-- Mission Section -->
    <section class="mission">
        <div class="mission-container">
            <div class="section-number">01</div>
            <h2 class="section-title animate-on-scroll">
                Democratizing AI power for individuals,
                <span class="italic-emphasis">not corporations</span>
            </h2>

            <div class="mission-grid">
                <div class="mission-card animate-on-scroll">
                    <div class="card-icon">
                        <iconify-icon icon="solar:user-speak-bold-duotone"></iconify-icon>
                    </div>
                    <h3>Direct & Opinionated</h3>
                    <p>15 years running 10Clouds taught me to cut through noise. I don't hedge positions—I share what actually works in the AI trenches.</p>
                </div>

                <div class="mission-card animate-on-scroll">
                    <div class="card-icon">
                        <iconify-icon icon="solar:code-bold-duotone"></iconify-icon>
                    </div>
                    <h3>Technical Authenticity</h3>
                    <p>Built AIConsole, an open-source desktop AI editor. 80 hours/week hands-on with AI—not theory, real implementation.</p>
                </div>

                <div class="mission-card animate-on-scroll">
                    <div class="card-icon">
                        <iconify-icon icon="solar:lightbulb-bold-duotone"></iconify-icon>
                    </div>
                    <h3>Practical Optimism</h3>
                    <p>Believer in AI's positive potential. Criticize corporate opacity while championing community-driven development.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Work Section -->
    <section class="work" id="work">
        <div class="work-container">
            <div class="section-number">02</div>
            <h2 class="section-title animate-on-scroll">Building in Public</h2>

            <div class="bento-grid">
                <div class="bento-large animate-on-scroll">
                    <div class="bento-content">
                        <iconify-icon icon="solar:programming-bold-duotone" class="bento-icon"></iconify-icon>
                        <h3>AIConsole</h3>
                        <p>Open-source desktop AI editor for building AI-powered workflows. Built with the belief that powerful AI tools should be accessible to everyone.</p>
                        <a href="https://github.com/10clouds/aiconsole" class="bento-link">
                            <span>View on GitHub</span>
                            <iconify-icon icon="solar:arrow-right-linear"></iconify-icon>
                        </a>
                    </div>
                </div>

                <div class="bento-small animate-on-scroll">
                    <div class="bento-content">
                        <iconify-icon icon="solar:buildings-2-bold-duotone" class="bento-icon"></iconify-icon>
                        <h3>10Clouds</h3>
                        <p>150+ person software agency, now focusing on AI-powered digital products.</p>
                    </div>
                </div>

                <div class="bento-small animate-on-scroll">
                    <div class="bento-content">
                        <iconify-icon icon="solar:pen-new-square-bold-duotone" class="bento-icon"></iconify-icon>
                        <h3>LinkedIn</h3>
                        <p>5-7 posts/week on AI, leadership, and the future of work.</p>
                    </div>
                </div>

                <div class="bento-medium animate-on-scroll">
                    <div class="bento-content">
                        <iconify-icon icon="solar:brain-bold-duotone" class="bento-icon"></iconify-icon>
                        <h3>The "Asperger Advantage"</h3>
                        <p>Direct communication, pattern recognition, and deep technical focus. What some call a "disadvantage" I call my superpower in the AI space.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Philosophy Section -->
    <section class="philosophy">
        <div class="philosophy-container">
            <div class="section-number">03</div>

            <div class="philosophy-content animate-on-scroll">
                <blockquote class="philosophy-quote">
                    "After 80 hours/week with AI, I see a world where individuals have the same computational power as corporations. We're not there yet—but we're closer than you think."
                </blockquote>

                <div class="philosophy-stats">
                    <div class="stat">
                        <div class="stat-number">15+</div>
                        <div class="stat-label">Years Leading 10Clouds</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number">80</div>
                        <div class="stat-label">Hours/Week in AI</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number">150+</div>
                        <div class="stat-label">Team Members</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="contact" id="contact">
        <div class="contact-container">
            <div class="section-number">04</div>
            <h2 class="section-title animate-on-scroll">Let's Talk</h2>

            <div class="contact-grid">
                <div class="contact-info animate-on-scroll">
                    <p class="contact-intro">
                        Whether you're interested in AI strategy, want to discuss a project,
                        or just want to exchange ideas about the future of AI—I'm open to conversations.
                    </p>

                    <div class="contact-methods">
                        <a href="https://linkedin.com/in/cielecki" class="contact-method">
                            <iconify-icon icon="solar:linkedin-bold"></iconify-icon>
                            <span>LinkedIn</span>
                            <iconify-icon icon="solar:arrow-right-up-linear" class="external"></iconify-icon>
                        </a>
                        <a href="https://twitter.com/cielecki" class="contact-method">
                            <iconify-icon icon="solar:logo-twitter"></iconify-icon>
                            <span>X / Twitter</span>
                            <iconify-icon icon="solar:arrow-right-up-linear" class="external"></iconify-icon>
                        </a>
                        <a href="mailto:maciej@cielecki.com" class="contact-method">
                            <iconify-icon icon="solar:letter-bold"></iconify-icon>
                            <span>maciej@cielecki.com</span>
                            <iconify-icon icon="solar:arrow-right-up-linear" class="external"></iconify-icon>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-content">
                <div class="footer-brand">
                    <div class="logo">MC</div>
                    <p>AI Loyalist • Executive Chairman at 10Clouds</p>
                </div>

                <div class="footer-links">
                    <a href="https://github.com/cielecki" target="_blank">
                        <iconify-icon icon="solar:github-bold"></iconify-icon>
                    </a>
                    <a href="https://linkedin.com/in/cielecki" target="_blank">
                        <iconify-icon icon="solar:linkedin-bold"></iconify-icon>
                    </a>
                    <a href="https://twitter.com/cielecki" target="_blank">
                        <iconify-icon icon="solar:logo-twitter"></iconify-icon>
                    </a>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; 2026 Maciej Cielecki. Built with intention, not templates.</p>
            </div>
        </div>
    </footer>
</body>
</html>

<style is:global>
@import '../styles/main.css';
</style>

<script>
import '../scripts/main.js';
</script>
