---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Maciej Cielecki">

  <div class="min-h-screen flex flex-col">
  <main class="relative flex-1 flex items-center px-6 py-16 overflow-hidden">
    <div class="absolute top-20 -right-32 w-96 h-96 bg-terracotta/10 blob blur-3xl"></div>
    <div class="absolute -bottom-20 -left-32 w-80 h-80 bg-sage/15 blob blur-3xl"></div>

    <div class="relative z-10 max-w-5xl mx-auto w-full grid lg:grid-cols-[auto_1fr] gap-12 lg:gap-16 items-center">

      <div class="flex justify-center lg:justify-start">
        <div class="relative">
          <div class="absolute -inset-4 rounded-[2rem] border border-terracotta/15 -rotate-3"></div>
          <div class="absolute -inset-8 rounded-[2.5rem] border border-sage/10 rotate-2"></div>
          <img
            src="/images/hero-portrait.jpg"
            alt="Maciej Cielecki"
            class="w-64 sm:w-72 lg:w-80 aspect-square object-cover object-top rounded-2xl shadow-2xl shadow-charcoal/10 relative"
          />
        </div>
      </div>

      <div class="text-center lg:text-left">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.05] text-charcoal-dark mb-6 animate-fade-in-up">
          Maciej <span class="italic text-terracotta-dark">Cielecki</span>
        </h1>

        <p class="text-lg sm:text-xl text-charcoal-light leading-relaxed max-w-xl mx-auto lg:mx-0 mb-10 animate-fade-in-up-d1">
          Builder. Founded 10Clouds and grew it from zero to 200 people as CEO. Now stepped back to Executive Chairman &mdash; obsessively deep in AI, building things that help people.
        </p>

        <div class="flex flex-col gap-2 max-w-md mx-auto lg:mx-0 animate-fade-in-up-d2">
          <a href="https://cielecki.substack.com" target="_blank" rel="noopener" class="group flex items-center gap-4 px-4 py-3.5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-left hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <div class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-terracotta/10 rounded-lg text-terracotta">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-charcoal-dark">Essays</div>
              <div class="text-sm text-charcoal-light leading-snug mt-0.5">Long-form ideas on AI and building &mdash; on Substack</div>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 w-4 h-4 text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="https://linkedin.com/in/cielecki" target="_blank" rel="noopener" class="group flex items-center gap-4 px-4 py-3.5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-left hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <div class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-terracotta/10 rounded-lg text-terracotta">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-charcoal-dark">LinkedIn</div>
              <div class="text-sm text-charcoal-light leading-snug mt-0.5">Daily posts on AI, building, and leadership</div>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 w-4 h-4 text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="https://x.com/mcielecki" target="_blank" rel="noopener" class="group flex items-center gap-4 px-4 py-3.5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-left hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <div class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-terracotta/10 rounded-lg text-terracotta">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-charcoal-dark">X / Twitter</div>
              <div class="text-sm text-charcoal-light leading-snug mt-0.5">Quick, sharper takes on AI</div>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 w-4 h-4 text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all"><polyline points="9 18 15 12 9 6"/></svg>
          </a>

          <a href="https://github.com/cielecki" target="_blank" rel="noopener" class="group flex items-center gap-4 px-4 py-3.5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl text-left hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all">
            <div class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-terracotta/10 rounded-lg text-terracotta">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            </div>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-charcoal-dark">GitHub</div>
              <div class="text-sm text-charcoal-light leading-snug mt-0.5">AIConsole and other open-source work</div>
            </div>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 w-4 h-4 text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>

    </div>
  </main>

  <footer class="py-6 px-6 text-center">
    <p class="text-sm text-charcoal-light/60">&copy; 2026 Maciej Cielecki</p>
  </footer>
  </div>

</BaseLayout>
