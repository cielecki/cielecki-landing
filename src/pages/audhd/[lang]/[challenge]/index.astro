---
import { getCollection, type CollectionEntry } from 'astro:content';
import AudhdLayout from '../../../../layouts/AudhdLayout.astro';
import { useTranslations, otherLang, type Lang } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const challenges = await getCollection('challenges');
  return challenges.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, challenge: slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'challenges'>;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const challengeSlug = Astro.params.challenge!;
const t = useTranslations(lang);

const methods = (
  await getCollection(
    'methods',
    (m) => m.data.lang === lang && m.data.challenge === challengeSlug
  )
).sort((a, b) => a.data.order - b.data.order);

const slugOf = (id: string) => id.split('/').pop()!;
const altLangUrl = `/audhd/${otherLang(lang)}/${challengeSlug}/`;
---

<AudhdLayout
  lang={lang}
  title={entry.data.title}
  altLangUrl={altLangUrl}
  crumbs={[{ label: entry.data.title }]}
>
  <header class="mb-8 reveal">
    <div class="flex items-center gap-3 mb-3">
      <span class="flex-shrink-0 w-12 h-12 flex items-center justify-center bg-terracotta/10 rounded-xl text-terracotta-dark">
        <span class="iconify text-2xl" data-icon={entry.data.icon} />
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal-dark leading-tight">
        {entry.data.title}
      </h1>
    </div>
    <p class="text-lg text-charcoal-light leading-relaxed max-w-2xl">{entry.data.summary}</p>
  </header>

  <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-4">
    {t('challenge.methods')}
  </h2>

  {
    methods.length === 0 ? (
      <div class="p-6 rounded-2xl border border-dashed border-charcoal/15 bg-white/40 text-charcoal-light">
        {t('challenge.empty')}
      </div>
    ) : (
      <ul class="grid gap-3">
        {methods.map((m) => {
          const slug = slugOf(m.id);
          return (
            <li class="reveal">
              <a
                href={`/audhd/${lang}/${challengeSlug}/${slug}/`}
                class="group flex items-start gap-4 p-5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-2xl hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all"
              >
                <div class="flex-1 min-w-0">
                  <h3 class="font-serif text-lg font-semibold text-charcoal-dark leading-snug group-hover:text-terracotta-dark transition-colors">
                    {m.data.title}
                  </h3>
                  <p class="text-sm text-charcoal-light leading-relaxed mt-1">{m.data.summary}</p>
                  {m.data.resources.length > 0 && (
                    <span class="inline-flex items-center gap-1 text-xs text-charcoal-light/60 mt-2">
                      <span class="iconify text-sm" data-icon="mdi:link-variant" />
                      {m.data.resources.length}
                    </span>
                  )}
                </div>
                <span class="iconify flex-shrink-0 mt-1 text-lg text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all" data-icon="mdi:arrow-right" />
              </a>
            </li>
          );
        })}
      </ul>
    )
  }
</AudhdLayout>
