---
import { getCollection } from 'astro:content';
import AudhdLayout from '../../../layouts/AudhdLayout.astro';
import { useTranslations, otherLang, languages, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const symptoms = (await getCollection('symptoms', (e) => e.data.lang === lang)).sort(
  (a, b) => a.data.order - b.data.order
);

const slugOf = (id: string) => id.split('/').pop()!;
const altLangUrl = `/nt/${otherLang(lang)}/`;
---

<AudhdLayout lang={lang} title={t('nav.challenges')} altLangUrl={altLangUrl}>
  <header class="mb-10 reveal">
    <div class="flex items-center gap-2 mb-3">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-charcoal-dark leading-tight">
        {t('site.title')}
      </h1>
      <span class="px-2 py-0.5 rounded-full bg-terracotta/15 text-terracotta-dark text-xs font-semibold uppercase tracking-wide">
        {t('nt.pilot')}
      </span>
    </div>
    <p class="text-lg sm:text-xl text-charcoal leading-relaxed max-w-2xl mb-3">{t('site.tagline')}</p>
    <p class="text-base text-charcoal-light/80 leading-relaxed max-w-2xl">{t('nt.intro')}</p>
  </header>

  <ul class="grid gap-3 sm:grid-cols-2">
    {
      symptoms.map((s) => {
        const slug = slugOf(s.id);
        return (
          <li class="reveal" data-conditions={s.data.conditions.join(' ')}>
            <a
              href={`/nt/${lang}/symptom/${slug}/`}
              class="group flex flex-col h-full gap-3 p-5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-2xl hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all"
            >
              <div class="flex items-center gap-3">
                <span class="flex-shrink-0 w-11 h-11 flex items-center justify-center bg-terracotta/10 rounded-xl text-terracotta-dark">
                  <span class="iconify text-2xl" data-icon={s.data.icon} />
                </span>
                <h2 class="font-serif text-lg font-semibold text-charcoal-dark leading-snug group-hover:text-terracotta-dark transition-colors">
                  {s.data.title}
                </h2>
              </div>
              <p class="text-sm text-charcoal-light leading-relaxed flex-1">{s.data.summary}</p>
              <span class="iconify self-end text-base text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all" data-icon="mdi:arrow-right" />
            </a>
          </li>
        );
      })
    }
  </ul>
</AudhdLayout>
