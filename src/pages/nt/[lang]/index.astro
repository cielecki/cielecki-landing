---
import { getCollection } from 'astro:content';
import AudhdLayout from '../../../layouts/AudhdLayout.astro';
import { useTranslations, otherLang, languages, type Lang } from '../../../i18n/ui';
import { NAV_GROUPS } from '../../../lib/nt-nav';

export async function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const symptoms = await getCollection('symptoms', (e) => e.data.lang === lang);
const slugOf = (id: string) => id.split('/').pop()!;
const map = new Map(symptoms.map((s) => [slugOf(s.id), s]));

// Group the entry points by the frozen taxonomy themes so the directory reads as
// a small set of categories instead of one long flat list.
const groups = NAV_GROUPS.map((g) => ({
  label: g.label[lang],
  items: g.symptoms.map((slug) => map.get(slug)).filter((s): s is NonNullable<typeof s> => !!s),
})).filter((g) => g.items.length > 0);

const altLangUrl = `/nt/${otherLang(lang)}/`;
---

<AudhdLayout lang={lang} title={t('nav.challenges')} altLangUrl={altLangUrl}>
  <header class="mb-10 reveal">
    <div class="flex items-center gap-2 mb-3">
      <h1 class="font-serif text-4xl sm:text-5xl font-bold text-charcoal-dark leading-tight">
        {t('site.title')}
      </h1>
      <span class="px-2 py-0.5 rounded-full bg-terracotta/15 text-terracotta-dark text-xs font-semibold uppercase tracking-wide">
        {t('nt.pilot')}
      </span>
    </div>
    <p class="text-lg sm:text-xl text-charcoal leading-relaxed max-w-2xl mb-3">{t('site.tagline')}</p>
    <p class="text-base text-charcoal-light/80 leading-relaxed max-w-2xl">{t('nt.intro')}</p>
  </header>

  {
    groups.map((g) => (
      <section class="mb-10 reveal">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/55 mb-3 pb-2 border-b border-charcoal/8">
          {g.label}
        </h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {g.items.map((s) => {
            const slug = slugOf(s.id);
            return (
              <li data-conditions={s.data.conditions.join(' ')}>
                <a
                  href={`/nt/${lang}/symptom/${slug}/`}
                  class="group flex flex-col h-full gap-2.5 p-4 bg-white/60 backdrop-blur border border-charcoal/8 rounded-2xl hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all"
                >
                  <div class="flex items-center gap-2.5">
                    <span class="flex-shrink-0 w-9 h-9 flex items-center justify-center bg-terracotta/10 rounded-lg text-terracotta-dark">
                      <span class="iconify text-xl" data-icon={s.data.icon} />
                    </span>
                    <h3 class="font-serif text-base font-semibold text-charcoal-dark leading-snug group-hover:text-terracotta-dark transition-colors">
                      {s.data.title}
                    </h3>
                  </div>
                  <p class="text-sm text-charcoal-light leading-relaxed flex-1">{s.data.summary}</p>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
</AudhdLayout>
