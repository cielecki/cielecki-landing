---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import AudhdLayout from '../../../../layouts/AudhdLayout.astro';
import Signals from '../../../../components/Signals.astro';
import { useTranslations, otherLang, type Lang, type UIKey } from '../../../../i18n/ui';
import { edgeScore, sourceCount, sourcesLabel, conditionIcon, conditionColor, evidenceClass, gradeOrder } from '../../../../lib/signals';

export async function getStaticPaths() {
  const protocols = await getCollection('protocols');
  return protocols.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'protocols'>;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const t = useTranslations(lang);
const { Content } = await render(entry);

const slugOf = (id: string) => id.split('/').pop()!;

const mechanisms = await getCollection('mechanisms', (m) => m.data.lang === lang);
const symptoms = await getCollection('symptoms', (s) => s.data.lang === lang);
const mechMap = new Map(mechanisms.map((m) => [slugOf(m.id), m]));
const sympMap = new Map(symptoms.map((s) => [slugOf(s.id), s]));

// Independent sources backing this method — a property of the method, not of any
// single target, so the same count applies to every edge it makes.
const methodSources = sourceCount(entry.data.resources);

// ── What this method helps with (graph traversal — kept CONSISTENT with the symptom
// page) ───────────────────────────────────────────────────────────────────────────
// A method helps a symptom when it addresses that symptom directly OR addresses a
// mechanism that underlies it. We surface the mechanisms it works through AND every
// symptom reached (directly or via a mechanism), so the symptom→method link always
// closes back to the symptom you arrived from — no dangling one-way edges.
const mechLinks = entry.data.addresses
  .filter((e) => e.kind === 'mechanism')
  .map((e) => {
    const m = mechMap.get(e.target);
    if (!m) return null;
    return {
      title: m.data.title,
      icon: m.data.icon,
      href: `/nt/${lang}/mechanizm/${e.target}/`,
      ev: e.evidence,
      note: e.note,
      score: edgeScore(e.evidence, methodSources),
    };
  })
  .filter((x): x is NonNullable<typeof x> => x !== null)
  .sort((a, b) => b.score - a.score);

type SympLink = {
  title: string;
  icon: string;
  href: string;
  ev: string;
  note?: string;
  via: string[];
  direct: boolean;
  score: number;
};
const sympAgg = new Map<string, SympLink>();
const addSymp = (sl: string, ev: string, opts: { direct?: boolean; via?: string; note?: string }) => {
  const target = sympMap.get(sl);
  if (!target) return;
  const score = edgeScore(ev, methodSources);
  const cur = sympAgg.get(sl);
  if (!cur) {
    sympAgg.set(sl, {
      title: target.data.title,
      icon: target.data.icon,
      href: `/nt/${lang}/symptom/${sl}/`,
      ev,
      note: opts.note,
      via: opts.via ? [opts.via] : [],
      direct: !!opts.direct,
      score,
    });
  } else {
    if (score > cur.score) { cur.score = score; cur.ev = ev; }
    if (opts.direct) cur.direct = true;
    if (opts.note && !cur.note) cur.note = opts.note;
    if (opts.via && !cur.via.includes(opts.via)) cur.via.push(opts.via);
  }
};
// Only symptoms this method addresses DIRECTLY. We no longer flatten in the symptoms
// behind each mechanism — that produced one-way-feeling nonsense (a method showing under
// a symptom it doesn't really help). Mechanisms it works through are listed separately
// below (mechLinks); click through to see that mechanism's own methods.
for (const e of entry.data.addresses) {
  if (e.kind === 'symptom') addSymp(e.target, e.evidence, { direct: true, note: e.note });
}
const sympLinks = [...sympAgg.values()].sort((a, b) => b.score - a.score);
const hasLinks = sympLinks.length > 0 || mechLinks.length > 0;

// Breadcrumb parent: a directly-addressed symptom, else the symptom behind the first mechanism.
let parentSymptom = entry.data.addresses.find((e) => e.kind === 'symptom')?.target;
if (!parentSymptom) {
  const firstMech = entry.data.addresses.find((e) => e.kind === 'mechanism');
  if (firstMech) parentSymptom = mechMap.get(firstMech.target)?.data.symptoms[0];
}
const parent = parentSymptom ? sympMap.get(parentSymptom) : undefined;
const crumbs = parent
  ? [{ label: parent.data.title, href: `/nt/${lang}/symptom/${parentSymptom}/` }, { label: entry.data.title }]
  : [{ label: entry.data.title }];

const resourceIcon: Record<string, string> = {
  video: 'mdi:play-circle-outline',
  article: 'mdi:text-box-outline',
  book: 'mdi:book-open-variant',
  podcast: 'mdi:podcast',
  app: 'mdi:cellphone',
  product: 'mdi:tag-outline',
  tool: 'mdi:tools',
  specialist: 'mdi:account-tie-outline',
};

// A timestamped link (…&t=NNNs) points at one moment in a long video. Surface that
// as a "clip from MM:SS" badge so it's clear the link is a fragment, not the whole film.
function fmtTime(total: number): string {
  const h = Math.floor(total / 3600);
  const m = Math.floor((total % 3600) / 60);
  const s = total % 60;
  const pad = (n: number) => String(n).padStart(2, '0');
  return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
}
function fragmentAt(url?: string): string | null {
  if (!url) return null;
  const m = url.match(/[?&]t=(\d+)/);
  return m ? fmtTime(parseInt(m[1], 10)) : null;
}

const studyIcon: Record<string, string> = {
  'meta-analysis': 'mdi:chart-box-outline',
  rct: 'mdi:flask-outline',
  cohort: 'mdi:account-group-outline',
  review: 'mdi:text-box-search-outline',
  guideline: 'mdi:clipboard-text-outline',
  other: 'mdi:school-outline',
};

const altLangUrl = `/nt/${otherLang(lang)}/metoda/${slug}/`;
---

<AudhdLayout lang={lang} title={entry.data.title} altLangUrl={altLangUrl} crumbs={crumbs} showNav={true} activeSlug={parentSymptom}>
  <article class="reveal">
    <header class="mb-6">
      <div class="flex items-center gap-1.5 mb-2 text-xs font-semibold uppercase tracking-wider text-sage-dark">
        <span class="iconify text-sm" data-icon="mdi:tools" />
        {t('type.method')}
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal-dark leading-tight mb-3">{entry.data.title}</h1>
      <p class="text-lg text-charcoal-light leading-relaxed">{entry.data.summary}</p>
      <p
        data-applies={entry.data.conditions.join(' ')}
        class="ad-hidden mt-4 flex items-start gap-2 text-xs text-charcoal-light/75 bg-terracotta/8 border border-terracotta/15 rounded-lg px-3 py-2 max-w-2xl"
      >
        <span class="iconify text-sm mt-0.5 text-terracotta-dark flex-shrink-0" data-icon="mdi:information-outline" />
        {t('nt.notForProfile')}
      </p>
    </header>

    <div class="audhd-prose text-charcoal leading-relaxed max-w-2xl"><Content /></div>

    {
      hasLinks && (
        <section class="mt-10">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-4">{t('nt.helpsWith')}</h2>
          <ul class="grid gap-2.5">
            {sympLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="group flex items-start gap-3 p-4 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl hover:bg-white hover:-translate-y-0.5 hover:shadow-sm transition-all"
                >
                  <span class="iconify flex-shrink-0 mt-0.5 text-lg text-charcoal-light/70" data-icon={l.icon} />
                  <div class="flex-1 min-w-0">
                    <div class="text-[11px] font-semibold uppercase tracking-wide text-charcoal-light/45">{t('type.symptom')}</div>
                    <div class="font-medium text-charcoal-dark leading-snug group-hover:text-terracotta-dark transition-colors">
                      {l.title}
                    </div>
                    <div class="mt-1.5">
                      <Signals evidence={l.ev} sources={methodSources} lang={lang} muted={entry.data.studies.length === 0} hideSources={true} />
                    </div>
                    {!l.direct && l.via.length > 0 && (
                      <p class="text-xs text-charcoal-light/55 mt-1.5">{t('nt.viaMechanism')}: {l.via.join(', ')}</p>
                    )}
                    {l.note && <p class="text-xs text-charcoal-light/70 italic mt-1.5">{l.note}</p>}
                  </div>
                  <span class="iconify flex-shrink-0 mt-1 text-base text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all" data-icon="mdi:arrow-right" />
                </a>
              </li>
            ))}
            {mechLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="group flex items-start gap-3 p-4 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl hover:bg-white hover:-translate-y-0.5 hover:shadow-sm transition-all"
                >
                  <span class="iconify flex-shrink-0 mt-0.5 text-lg text-charcoal-light/70" data-icon={l.icon} />
                  <div class="flex-1 min-w-0">
                    <div class="text-[11px] font-semibold uppercase tracking-wide text-charcoal-light/45">{t('type.mechanism')}</div>
                    <div class="font-medium text-charcoal-dark leading-snug group-hover:text-terracotta-dark transition-colors">
                      {l.title}
                    </div>
                    <div class="mt-1.5">
                      <Signals evidence={l.ev} sources={methodSources} lang={lang} muted={entry.data.studies.length === 0} hideSources={true} />
                    </div>
                    {l.note && <p class="text-xs text-charcoal-light/70 italic mt-1.5">{l.note}</p>}
                  </div>
                  <span class="iconify flex-shrink-0 mt-1 text-base text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all" data-icon="mdi:arrow-right" />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-10 pt-6 border-t border-charcoal/8">
      <div class="flex items-center justify-between gap-3 mb-4">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60">{t('method.resources')}</h2>
        {methodSources > 0 && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-terracotta/12 text-terracotta-dark" title={t('nt.sourcesHint')}>
            <span class="iconify text-sm" data-icon="mdi:account-voice" />
            {sourcesLabel(methodSources, lang)}
          </span>
        )}
      </div>
      {
        entry.data.resources.length === 0 ? (
          <p class="text-charcoal-light/70 text-sm">{t('method.noResources')}</p>
        ) : (
          <ul class="grid gap-2.5">
            {entry.data.resources.map((r) => {
              const label = t(`resource.${r.type}` as UIKey);
              const icon = resourceIcon[r.type] ?? 'mdi:link-variant';
              const frag = fragmentAt(r.url);
              const inner = (
                <>
                  <span class="flex-shrink-0 w-9 h-9 flex items-center justify-center bg-sand/30 rounded-lg text-charcoal-light">
                    <span class="iconify text-lg" data-icon={icon} />
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-charcoal-dark leading-snug">{r.title}</div>
                    <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-xs text-charcoal-light/60 mt-1">
                      <span>{label}</span>
                      {r.author && <span>· {r.author}</span>}
                      {frag && (
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-terracotta/10 text-terracotta-dark font-medium">
                          <span class="iconify text-sm" data-icon="mdi:play-circle" />
                          {t('resource.fragment')} {frag}
                        </span>
                      )}
                      {!r.url && <span>· {t('method.linkSoon')}</span>}
                    </div>
                    {r.note && (
                      <p class="text-sm text-charcoal-light/80 italic leading-relaxed mt-1.5">{r.note}</p>
                    )}
                  </div>
                  {r.url && (
                    <span class="iconify flex-shrink-0 mt-0.5 text-base text-charcoal-light/40 group-hover:text-terracotta transition-colors" data-icon="mdi:open-in-new" />
                  )}
                </>
              );
              return (
                <li>
                  {r.url ? (
                    <a
                      href={r.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-start gap-3 p-3.5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl hover:bg-white hover:-translate-y-0.5 hover:shadow-sm transition-all"
                    >
                      {inner}
                    </a>
                  ) : (
                    <div class="flex items-start gap-3 p-3.5 bg-white/40 border border-charcoal/8 rounded-xl opacity-80">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>

    <section id="badania" class="mt-10 pt-6 border-t border-charcoal/8 scroll-mt-24">
      {entry.data.studies.length > 0 && (
        <>
          <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-1">{t('nt.research')}</h2>
          <p class="text-xs text-charcoal-light/55 mb-4 max-w-2xl">{t('nt.researchNote')}</p>
          <ul class="grid gap-2.5 mb-8">
            {entry.data.studies.map((s) => {
              const icon = studyIcon[s.type] ?? 'mdi:school-outline';
              const inner = (
                <>
                  <span class="flex-shrink-0 w-9 h-9 flex items-center justify-center bg-sage/15 rounded-lg text-sage-dark">
                    <span class="iconify text-lg" data-icon={icon} />
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-charcoal-dark leading-snug">{s.title}</div>
                    <div class="text-xs text-charcoal-light/60 mt-0.5 uppercase tracking-wide">
                      {t(`study.${s.type}` as UIKey)}
                      {s.year ? ` · ${s.year}` : ''}
                    </div>
                    {s.finding && <p class="text-sm text-charcoal-light/80 leading-relaxed mt-1.5">{s.finding}</p>}
                  </div>
                  {s.url && (
                    <span class="iconify flex-shrink-0 mt-0.5 text-base text-charcoal-light/40 group-hover:text-terracotta transition-colors" data-icon="mdi:open-in-new" />
                  )}
                </>
              );
              return (
                <li>
                  {s.url ? (
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-start gap-3 p-3.5 bg-sage/5 border border-sage/20 rounded-xl hover:bg-sage/10 hover:-translate-y-0.5 hover:shadow-sm transition-all"
                    >
                      {inner}
                    </a>
                  ) : (
                    <div class="flex items-start gap-3 p-3.5 bg-sage/5 border border-sage/20 rounded-xl">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      )}

      <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-3">{t('nt.evidenceLegend')}</h2>
      <div class="grid gap-1.5 max-w-2xl">
        {gradeOrder.map((g) => (
          <div class="flex items-baseline gap-2.5 text-xs text-charcoal-light/75 leading-relaxed">
            <span class={`flex-shrink-0 inline-flex w-6 justify-center px-1.5 py-0.5 rounded-full font-semibold ${evidenceClass[g]}`}>{g}</span>
            <span>{t(`evExplain.${g}` as UIKey)}</span>
          </div>
        ))}
      </div>
    </section>

    <div class="mt-10 pt-6 border-t border-charcoal/8 flex flex-wrap items-center gap-1.5">
      <span class="text-xs text-charcoal-light/60 mr-1">{t('nt.appliesTo')}:</span>
      {entry.data.conditions.map((c) => (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/70 border border-charcoal/8 text-xs text-charcoal-light">
          <span class="iconify text-sm" data-icon={conditionIcon[c]} style={`color:${conditionColor[c]}`} />
          {t(`profile.${c}` as UIKey)}
        </span>
      ))}
    </div>
  </article>
</AudhdLayout>
