---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import AudhdLayout from '../../../../layouts/AudhdLayout.astro';
import Signals from '../../../../components/Signals.astro';
import { useTranslations, otherLang, type Lang, type UIKey } from '../../../../i18n/ui';
import { edgeScore, sourceCount, conditionIcon, conditionColor } from '../../../../lib/signals';

export async function getStaticPaths() {
  const mechanisms = await getCollection('mechanisms');
  return mechanisms.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}

interface Props {
  entry: CollectionEntry<'mechanisms'>;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const t = useTranslations(lang);
const { Content } = await render(entry);

const slugOf = (id: string) => id.split('/').pop()!;

// Parent symptom(s) for the breadcrumb + "helps with" back-links.
const symptoms = await getCollection('symptoms', (s) => s.data.lang === lang);
const parents = symptoms.filter((s) => entry.data.symptoms.includes(slugOf(s.id)));

// Protocols that address THIS mechanism, with the signals for this edge.
const protocols = await getCollection('protocols', (p) => p.data.lang === lang);
type Ranked = { p: CollectionEntry<'protocols'>; ev: string; sources: number; note?: string; score: number };
const ranked: Ranked[] = [];
for (const p of protocols) {
  const e = p.data.addresses.find((a) => a.kind === 'mechanism' && a.target === slug);
  if (!e) continue;
  const sources = sourceCount(p.data.resources);
  ranked.push({ p, ev: e.evidence, sources, note: e.note, score: edgeScore(e.evidence, sources) });
}
ranked.sort((a, b) => b.score - a.score);

const parentSlug = parents[0] ? slugOf(parents[0].id) : undefined;
const crumbs = parents[0]
  ? [{ label: parents[0].data.title, href: `/nt/${lang}/symptom/${parentSlug}/` }, { label: entry.data.title }]
  : [{ label: entry.data.title }];
const altLangUrl = `/nt/${otherLang(lang)}/mechanizm/${slug}/`;
---

<AudhdLayout lang={lang} title={entry.data.title} altLangUrl={altLangUrl} crumbs={crumbs} showNav={true} activeSlug={parentSlug}>
  <article class="reveal">
    <header class="mb-6">
      <div class="flex items-center gap-1.5 mb-2 text-xs font-semibold uppercase tracking-wider text-charcoal-light/60">
        <span class="iconify text-sm" data-icon="mdi:cog-outline" />
        {t('type.mechanism')}
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal-dark leading-tight mb-3">{entry.data.title}</h1>
      <p class="text-lg text-charcoal-light leading-relaxed">{entry.data.summary}</p>
      <p
        data-applies={entry.data.conditions.join(' ')}
        class="ad-hidden mt-4 flex items-start gap-2 text-xs text-charcoal-light/75 bg-terracotta/8 border border-terracotta/15 rounded-lg px-3 py-2 max-w-2xl"
      >
        <span class="iconify text-sm mt-0.5 text-terracotta-dark flex-shrink-0" data-icon="mdi:information-outline" />
        {t('nt.notForProfile')}
      </p>
    </header>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-2">{t('nt.background')}</h2>
    <div class="audhd-prose text-charcoal leading-relaxed mb-10 max-w-2xl"><Content /></div>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-4">{t('nt.methodsHere')}</h2>
    <ul class="grid gap-3 xl:grid-cols-2">
      {
        ranked.map(({ p, ev, sources, note }) => {
          const pslug = slugOf(p.id);
          return (
            <li class="reveal" data-conditions={p.data.conditions.join(' ')}>
              <a
                href={`/nt/${lang}/metoda/${pslug}/`}
                class="group flex items-start gap-4 p-5 bg-white/60 backdrop-blur border border-charcoal/8 rounded-2xl hover:bg-white hover:-translate-y-0.5 hover:shadow-md transition-all"
              >
                <span class="flex-shrink-0 w-10 h-10 flex items-center justify-center bg-sage/15 rounded-xl text-sage-dark">
                  <span class="iconify text-xl" data-icon={p.data.icon} />
                </span>
                <div class="flex-1 min-w-0">
                  <h3 class="font-serif text-lg font-semibold text-charcoal-dark leading-snug group-hover:text-terracotta-dark transition-colors">
                    {p.data.title}
                  </h3>
                  <p class="text-sm text-charcoal-light leading-relaxed mt-1 mb-2.5">{p.data.summary}</p>
                  <Signals evidence={ev} sources={sources} lang={lang} muted={p.data.studies.length === 0} />
                  {note && <p class="text-xs text-charcoal-light/70 italic mt-2">{note}</p>}
                </div>
                <span class="iconify flex-shrink-0 mt-1 text-lg text-charcoal-light/40 group-hover:text-terracotta group-hover:translate-x-0.5 transition-all" data-icon="mdi:arrow-right" />
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="mt-10 pt-6 border-t border-charcoal/8 flex flex-wrap items-center gap-1.5">
      <span class="text-xs text-charcoal-light/60 mr-1">{t('nt.appliesTo')}:</span>
      {entry.data.conditions.map((c) => (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/70 border border-charcoal/8 text-xs text-charcoal-light">
          <span class="iconify text-sm" data-icon={conditionIcon[c]} style={`color:${conditionColor[c]}`} />
          {t(`profile.${c}` as UIKey)}
        </span>
      ))}
    </div>
  </article>
</AudhdLayout>
