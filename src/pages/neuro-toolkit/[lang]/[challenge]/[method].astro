---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import AudhdLayout from '../../../../layouts/AudhdLayout.astro';
import { useTranslations, otherLang, type Lang, type UIKey } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const methods = await getCollection('methods');
  return methods.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return {
      params: { lang, challenge: entry.data.challenge, method: slug },
      props: { entry },
    };
  });
}

interface Props {
  entry: CollectionEntry<'methods'>;
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const challengeSlug = Astro.params.challenge!;
const methodSlug = Astro.params.method!;
const t = useTranslations(lang);

const { Content } = await render(entry);

// Parent challenge (for the breadcrumb + back-link title)
const challenges = await getCollection('challenges', (c) => c.data.lang === lang);
const parent = challenges.find((c) => c.id.split('/').pop() === challengeSlug);
const parentTitle = parent?.data.title ?? challengeSlug;

const altLangUrl = `/neuro-toolkit/${otherLang(lang)}/${challengeSlug}/${methodSlug}/`;

const resourceIcon: Record<string, string> = {
  video: 'mdi:play-circle-outline',
  article: 'mdi:text-box-outline',
  book: 'mdi:book-open-variant',
  podcast: 'mdi:podcast',
  app: 'mdi:cellphone',
  product: 'mdi:tag-outline',
  tool: 'mdi:tools',
  specialist: 'mdi:account-tie-outline',
};

const profileLabel: Record<string, string> = {
  adhd: t('profile.adhd'),
  autism: t('profile.autism'),
  audhd: t('profile.audhd'),
};
const profileIcon: Record<string, string> = {
  adhd: 'mdi:lightning-bolt',
  autism: 'mdi:infinity',
  audhd: 'mdi:yin-yang',
};
---

<AudhdLayout
  lang={lang}
  title={entry.data.title}
  altLangUrl={altLangUrl}
  crumbs={[
    { label: parentTitle, href: `/neuro-toolkit/${lang}/${challengeSlug}/` },
    { label: entry.data.title },
  ]}
>
  <article class="reveal">
    <header class="mb-6">
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal-dark leading-tight mb-3">
        {entry.data.title}
      </h1>
      <p class="text-lg text-charcoal-light leading-relaxed">{entry.data.summary}</p>
    </header>

    <div class="audhd-prose text-charcoal leading-relaxed">
      <Content />
    </div>

    {
      entry.data.lenses.length > 0 && (
        <section class="mt-8">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-3">
            {t('method.lenses')}
          </h2>
          <div class="grid gap-2.5">
            {entry.data.lenses.map((l) => (
              <div
                data-lens={l.profile}
                class="flex items-start gap-3 p-3.5 rounded-xl border border-charcoal/8 bg-sand/15"
              >
                <span class="flex-shrink-0 w-8 h-8 flex items-center justify-center bg-white/70 rounded-lg text-terracotta-dark">
                  <span class="iconify text-lg" data-icon={profileIcon[l.profile]} />
                </span>
                <div class="flex-1 min-w-0">
                  <div class="text-xs font-semibold text-charcoal-dark uppercase tracking-wide">
                    {profileLabel[l.profile]}
                  </div>
                  <p class="text-sm text-charcoal-light leading-relaxed mt-0.5">{l.note}</p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-10 pt-6 border-t border-charcoal/8">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-light/60 mb-4">
        {t('method.resources')}
      </h2>
      {
        entry.data.resources.length === 0 ? (
          <p class="text-charcoal-light/70 text-sm">{t('method.noResources')}</p>
        ) : (
          <ul class="grid gap-2.5">
            {entry.data.resources.map((r) => {
              const label = t(`resource.${r.type}` as UIKey);
              const icon = resourceIcon[r.type] ?? 'mdi:link-variant';
              const inner = (
                <>
                  <span class="flex-shrink-0 w-9 h-9 flex items-center justify-center bg-sage/15 rounded-lg text-sage-dark">
                    <span class="iconify text-lg" data-icon={icon} />
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-charcoal-dark leading-snug">{r.title}</div>
                    <div class="text-xs text-charcoal-light/60 mt-0.5">
                      {label}
                      {r.author ? ` · ${r.author}` : ''}
                      {!r.url ? ` · ${t('method.linkSoon')}` : ''}
                    </div>
                  </div>
                  {r.url && (
                    <span class="iconify flex-shrink-0 text-base text-charcoal-light/40 group-hover:text-terracotta transition-colors" data-icon="mdi:open-in-new" />
                  )}
                </>
              );
              return (
                <li>
                  {r.url ? (
                    <a
                      href={r.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-3 p-3 bg-white/60 backdrop-blur border border-charcoal/8 rounded-xl hover:bg-white hover:-translate-y-0.5 hover:shadow-sm transition-all"
                    >
                      {inner}
                    </a>
                  ) : (
                    <div class="flex items-center gap-3 p-3 bg-white/40 border border-charcoal/8 rounded-xl opacity-80">
                      {inner}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>
  </article>
</AudhdLayout>

<style>
  .audhd-prose :global(p) {
    margin-bottom: 1rem;
  }
  .audhd-prose :global(h2) {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    color: #252f36;
    margin: 1.75rem 0 0.75rem;
  }
  .audhd-prose :global(h3) {
    font-family: 'Newsreader', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: #252f36;
    margin: 1.5rem 0 0.5rem;
  }
  .audhd-prose :global(ul),
  .audhd-prose :global(ol) {
    margin: 0.5rem 0 1rem;
    padding-left: 1.4rem;
  }
  .audhd-prose :global(ul) {
    list-style: disc;
  }
  .audhd-prose :global(ol) {
    list-style: decimal;
  }
  .audhd-prose :global(li) {
    margin-bottom: 0.4rem;
  }
  .audhd-prose :global(a) {
    color: #a8624a;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .audhd-prose :global(strong) {
    color: #252f36;
    font-weight: 600;
  }
  .audhd-prose :global(blockquote) {
    border-left: 3px solid #d99a7e;
    padding-left: 1rem;
    color: #4a5c68;
    font-style: italic;
    margin: 1rem 0;
  }
  .audhd-prose :global(code) {
    background: #ebe8e1;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    font-size: 0.9em;
  }
</style>
