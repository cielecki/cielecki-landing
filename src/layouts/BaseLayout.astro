---
interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = "Builder. Founded 10Clouds and grew it from zero to 200 people. Now Executive Chairman & Chief AI Officer.", lang = "en" } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <title>{title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">

    <!-- Iconify -->
    <script src="https://code.iconify.design/3/3.1.0/iconify.min.js" is:inline></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="grain overflow-x-hidden">
    <slot />

    <script>
      const reveal = (el: Element) => el.classList.add('visible');
      const els = document.querySelectorAll('.reveal');
      // threshold 0: fire as soon as any part enters. A .reveal taller than the
      // viewport never reaches a positive threshold, so a higher value would leave
      // it (and its whole subtree, via opacity:0) permanently hidden at load.
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            reveal(entry.target);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0, rootMargin: '0px 0px -40px 0px' });

      els.forEach((el) => observer.observe(el));
      // Safety net: never leave content hidden if the observer misfires.
      window.setTimeout(() => els.forEach(reveal), 1500);
    </script>
</body>
</html>

<style is:global>
  @import '../styles/main.css';
</style>
