---
import BaseLayout from './BaseLayout.astro';
import TopicNav from '../components/TopicNav.astro';
import SearchModal from '../components/SearchModal.astro';
import NtFooter from '../components/NtFooter.astro';
import { useTranslations, otherLang, languageNames, type Lang } from '../i18n/ui';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title: string;
  /** URL of the equivalent page in the other language (for the switcher). */
  altLangUrl: string;
  /** Breadcrumb trail after the AuDHD root (root is prepended automatically). */
  crumbs?: Crumb[];
  /** Show the persistent topic sidebar (detail pages: symptom/mechanism/method). */
  showNav?: boolean;
  /** Symptom slug to highlight in the sidebar. */
  activeSlug?: string;
}

const { lang, title, altLangUrl, crumbs = [], showNav = false, activeSlug } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const home = `/nt/${lang}/`;
const trail: Crumb[] = [{ label: t('breadcrumb.home'), href: home }, ...crumbs];

const profiles = [
  { id: 'adhd', label: t('filter.adhd') },
  { id: 'autism', label: t('filter.autism') },
  { id: 'audhd', label: t('filter.audhd') },
];
---

<BaseLayout title={`${title} · ${t('site.title')}`} description={t('site.description')} lang={lang}>
  <div class="min-h-screen flex flex-col bg-cream text-charcoal">
    <!-- decorative blobs -->
    <div class="pointer-events-none fixed top-24 -right-40 w-[28rem] h-[28rem] bg-terracotta/10 blob blur-3xl"></div>
    <div class="pointer-events-none fixed -bottom-32 -left-40 w-96 h-96 bg-sage/15 blob blur-3xl"></div>

    <header class="relative z-10 border-b border-charcoal/8">
      <div class="max-w-6xl mx-auto w-full px-6 py-4 flex flex-wrap items-center gap-x-4 gap-y-3">
        <a href={home} class="group flex items-center gap-3 flex-shrink-0">
          <span class="iconify text-terracotta-dark text-2xl" data-icon="mdi:brain"></span>
          <span class="font-serif text-xl font-bold text-charcoal-dark group-hover:text-terracotta-dark transition-colors">
            {t('site.title')}
          </span>
        </a>

        <div class="flex items-center gap-3 ml-auto">
          <SearchModal lang={lang} />

          <!-- profile selector as a segmented control (client-side filter) -->
          <div
            id="ad-profiles"
            class="flex items-center gap-2"
          >
            <span class="hidden sm:inline text-xs font-medium text-charcoal-light/60">{t('filter.label')}</span>
            <div class="inline-flex rounded-full border border-charcoal/15 overflow-hidden">
              {profiles.map((p, i) => (
                <button
                  type="button"
                  data-profile={p.id}
                  aria-pressed={p.id === 'adhd' ? 'true' : 'false'}
                  class={`ad-chip px-3 py-1 text-sm text-charcoal-light hover:bg-white/60 transition-colors${i > 0 ? ' border-l border-charcoal/15' : ''}`}
                >
                  {p.label}
                </button>
              ))}
            </div>
          </div>

          <a
            href={altLangUrl}
            class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-charcoal/10 bg-white/60 backdrop-blur text-sm font-medium text-charcoal-light hover:bg-white hover:text-terracotta-dark transition-all"
            title={languageNames[other]}
          >
            <span class="iconify text-base" data-icon="mdi:translate"></span>
            {other.toUpperCase()}
          </a>
        </div>
      </div>
    </header>

    <main class="relative z-10 flex-1 max-w-6xl mx-auto w-full px-6 pt-6 pb-8" data-pagefind-body>
      <!-- breadcrumb — only on sub-pages; lighter, in-content (not a band) -->
      {crumbs.length > 0 && (
        <nav class="mb-4" aria-label="breadcrumb">
          <ol class="flex flex-wrap items-center gap-1.5 text-xs text-charcoal-light/55">
            {trail.map((c, i) => (
              <li class="flex items-center gap-1.5">
                {i > 0 && <span class="iconify text-charcoal-light/40" data-icon="mdi:chevron-right"></span>}
                {c.href && i < trail.length - 1 ? (
                  <a href={c.href} class="hover:text-terracotta-dark transition-colors">{c.label}</a>
                ) : (
                  <span class="text-charcoal-light/70">{c.label}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}

      {showNav ? (
        <div class="lg:flex lg:gap-10 lg:items-start">
          <!-- persistent topic sidebar (desktop) -->
          <aside class="hidden lg:block lg:w-60 flex-shrink-0">
            <div class="sticky top-6 max-h-[calc(100vh-3rem)] overflow-y-auto pr-2 pb-6">
              <div class="px-3 mb-3 text-xs font-semibold uppercase tracking-wider text-charcoal-light/55">
                {t('nt.topics')}
              </div>
              <TopicNav lang={lang} activeSlug={activeSlug} />
            </div>
          </aside>

          <div class="min-w-0 flex-1">
            <!-- collapsible topic browser (mobile / tablet) -->
            <details class="lg:hidden mb-6 bg-white/60 backdrop-blur border border-charcoal/8 rounded-2xl">
              <summary class="flex items-center gap-2 px-4 py-3 cursor-pointer text-sm font-medium text-charcoal-dark select-none">
                <span class="iconify text-lg text-terracotta-dark" data-icon="mdi:compass-outline"></span>
                {t('nt.browseTopics')}
              </summary>
              <div class="px-2 pb-3 border-t border-charcoal/8 pt-3">
                <TopicNav lang={lang} activeSlug={activeSlug} />
              </div>
            </details>
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )}
    </main>

    <NtFooter lang={lang} altLangUrl={altLangUrl} />
  </div>
</BaseLayout>

<style is:global>
  .ad-hidden { display: none !important; }
  .ad-chip-active,
  .ad-chip-active:hover {
    background: #36454F !important;
    color: #F5F3EE !important;
    border-color: #36454F;
  }
  /* condition colour language: ADHD terracotta · autism sage · AuDHD violet blend */
  .ad-chip-active[data-profile='adhd'],
  .ad-chip-active[data-profile='adhd']:hover {
    background: #A8624A !important;
    border-color: #A8624A;
  }
  .ad-chip-active[data-profile='autism'],
  .ad-chip-active[data-profile='autism']:hover {
    background: #6E8268 !important;
    border-color: #6E8268;
  }
  .ad-chip-active[data-profile='audhd'],
  .ad-chip-active[data-profile='audhd']:hover {
    background: #7E6BA8 !important;
    border-color: #7E6BA8;
  }
  [data-lens] { transition: opacity 0.2s ease, box-shadow 0.2s ease; }
  .ad-lens-dim { opacity: 0.45; }
  .ad-lens-active { box-shadow: 0 0 0 2px rgba(139, 157, 131, 0.6); }
</style>

<script>
  const PROFILES = ['adhd', 'autism', 'audhd'];

  // A selected profile expands to the conditions it implies. AuDHD = both + the
  // interaction, so it shows everything and treats every lens as relevant.
  function impliedSet(profile: string): string[] {
    return profile === 'audhd' ? ['adhd', 'autism', 'audhd'] : [profile];
  }

  function applyProfile(profile: string) {
    const root = document.getElementById('ad-profiles');
    if (!root) return;
    const set = impliedSet(profile);

    root.querySelectorAll('.ad-chip').forEach((c) => {
      const on = c.getAttribute('data-profile') === profile;
      c.setAttribute('aria-pressed', on ? 'true' : 'false');
      c.classList.toggle('ad-chip-active', on);
    });

    document.querySelectorAll('[data-conditions]').forEach((el) => {
      const conds = (el.getAttribute('data-conditions') || '').split(' ').filter(Boolean);
      const show = conds.some((c) => set.includes(c));
      el.classList.toggle('ad-hidden', !show);
    });

    // Inverse of the above: a "not for this profile" note that appears ONLY when the
    // page you opened directly doesn't match the active profile (we don't hide the page).
    document.querySelectorAll('[data-applies]').forEach((el) => {
      const conds = (el.getAttribute('data-applies') || '').split(' ').filter(Boolean);
      const matches = conds.some((c) => set.includes(c));
      el.classList.toggle('ad-hidden', matches);
    });

    document.querySelectorAll('[data-lens]').forEach((el) => {
      const lp = el.getAttribute('data-lens');
      const relevant = !!lp && set.includes(lp);
      el.classList.toggle('ad-lens-active', relevant);
      el.classList.toggle('ad-lens-dim', !relevant);
    });
  }

  function setProfile(profile: string) {
    try { localStorage.setItem('audhd-profile', profile); } catch (e) {}
    applyProfile(profile);
  }

  function initProfile() {
    let profile = 'adhd';
    const q = new URL(window.location.href).searchParams.get('profile');
    if (q && PROFILES.includes(q)) {
      profile = q;
    } else {
      try {
        const saved = localStorage.getItem('audhd-profile');
        if (saved && PROFILES.includes(saved)) profile = saved;
      } catch (e) {}
    }
    const root = document.getElementById('ad-profiles');
    if (root) {
      root.querySelectorAll('.ad-chip').forEach((c) => {
        c.addEventListener('click', () => setProfile(c.getAttribute('data-profile') || 'audhd'));
      });
    }
    applyProfile(profile);
  }

  initProfile();
</script>
