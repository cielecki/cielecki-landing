---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, otherLang, languageNames, type Lang } from '../i18n/ui';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  lang: Lang;
  title: string;
  /** URL of the equivalent page in the other language (for the switcher). */
  altLangUrl: string;
  /** Breadcrumb trail after the AuDHD root (root is prepended automatically). */
  crumbs?: Crumb[];
}

const { lang, title, altLangUrl, crumbs = [] } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const home = `/audhd/${lang}/`;
const trail: Crumb[] = [{ label: t('breadcrumb.home'), href: home }, ...crumbs];

const profiles = [
  { id: 'adhd', label: t('filter.adhd') },
  { id: 'autism', label: t('filter.autism') },
  { id: 'audhd', label: t('filter.audhd') },
];
---

<BaseLayout title={`${title} · ${t('site.title')}`} description={t('site.description')} lang={lang}>
  <div class="min-h-screen flex flex-col bg-cream text-charcoal">
    <!-- decorative blobs -->
    <div class="pointer-events-none fixed top-24 -right-40 w-[28rem] h-[28rem] bg-terracotta/10 blob blur-3xl"></div>
    <div class="pointer-events-none fixed -bottom-32 -left-40 w-96 h-96 bg-sage/15 blob blur-3xl"></div>

    <header class="relative z-10 border-b border-charcoal/8">
      <div class="max-w-4xl mx-auto w-full px-6 py-5 flex items-center justify-between gap-4">
        <a href={home} class="group flex items-center gap-3">
          <span class="iconify text-terracotta-dark text-2xl" data-icon="mdi:brain"></span>
          <span class="font-serif text-xl font-bold text-charcoal-dark group-hover:text-terracotta-dark transition-colors">
            {t('site.title')}
          </span>
        </a>
        <a
          href={altLangUrl}
          class="flex-shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-charcoal/10 bg-white/60 backdrop-blur text-sm font-medium text-charcoal-light hover:bg-white hover:text-terracotta-dark transition-all"
          title={languageNames[other]}
        >
          <span class="iconify text-base" data-icon="mdi:translate"></span>
          {other.toUpperCase()}
        </a>
      </div>
    </header>

    <!-- profile selector (client-side filter; default = show all) -->
    <div
      id="ad-profiles"
      class="relative z-10 border-b border-charcoal/8 bg-cream-dark/40"
      data-hidden-label={t('filter.hidden')}
      data-showall-label={t('filter.showAll')}
    >
      <div class="max-w-4xl mx-auto w-full px-6 py-2.5 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-charcoal-light/70 mr-1">{t('filter.label')}</span>
        {profiles.map((p) => (
          <button
            type="button"
            data-profile={p.id}
            aria-pressed={p.id === 'audhd' ? 'true' : 'false'}
            class="ad-chip px-3 py-1 rounded-full text-sm border border-charcoal/10 bg-white/60 text-charcoal-light hover:bg-white transition-all"
          >
            {p.label}
          </button>
        ))}
      </div>
    </div>

    <!-- breadcrumb -->
    <nav class="relative z-10 max-w-4xl mx-auto w-full px-6 pt-6" aria-label="breadcrumb">
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-charcoal-light/70">
        {trail.map((c, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span class="iconify text-charcoal-light/40" data-icon="mdi:chevron-right"></span>}
            {c.href && i < trail.length - 1 ? (
              <a href={c.href} class="hover:text-terracotta-dark transition-colors">{c.label}</a>
            ) : (
              <span class="text-charcoal-light">{c.label}</span>
            )}
          </li>
        ))}
      </ol>
    </nav>

    <main class="relative z-10 flex-1 max-w-4xl mx-auto w-full px-6 py-8">
      <p id="ad-filter-notice" hidden class="mb-5 text-sm text-charcoal-light/70"></p>
      <slot />
    </main>

    <footer class="relative z-10 border-t border-charcoal/8 mt-12">
      <div class="max-w-4xl mx-auto w-full px-6 py-6 text-sm text-charcoal-light/70 leading-relaxed">
        {t('footer.disclaimer')}
      </div>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  .ad-hidden { display: none !important; }
  .ad-chip-active {
    background: #36454F;
    color: #F5F3EE;
    border-color: #36454F;
  }
  .ad-emph { box-shadow: 0 0 0 2px rgba(201, 126, 93, 0.55); }
  [data-lens] { transition: opacity 0.2s ease, box-shadow 0.2s ease; }
  .ad-lens-dim { opacity: 0.45; }
  .ad-lens-active { box-shadow: 0 0 0 2px rgba(139, 157, 131, 0.6); }
</style>

<script>
  const PROFILES = ['adhd', 'autism', 'audhd'];

  // A selected profile expands to the conditions it implies. AuDHD = both + the
  // interaction, so it shows everything and treats every lens as relevant.
  function impliedSet(profile: string): string[] {
    return profile === 'audhd' ? ['adhd', 'autism', 'audhd'] : [profile];
  }

  function applyProfile(profile: string) {
    const root = document.getElementById('ad-profiles');
    if (!root) return;
    const set = impliedSet(profile);

    root.querySelectorAll('.ad-chip').forEach((c) => {
      const on = c.getAttribute('data-profile') === profile;
      c.setAttribute('aria-pressed', on ? 'true' : 'false');
      c.classList.toggle('ad-chip-active', on);
    });

    let hidden = 0;
    document.querySelectorAll('[data-conditions]').forEach((el) => {
      const conds = (el.getAttribute('data-conditions') || '').split(' ').filter(Boolean);
      const show = conds.some((c) => set.includes(c));
      el.classList.toggle('ad-hidden', !show);
      if (!show) hidden++;
      el.classList.toggle('ad-emph', profile === 'audhd' && conds.includes('audhd'));
    });

    const notice = document.getElementById('ad-filter-notice');
    if (notice) {
      if (hidden > 0) {
        const hl = root.getAttribute('data-hidden-label') || 'hidden';
        const sa = root.getAttribute('data-showall-label') || 'show all';
        notice.innerHTML =
          hidden + ' ' + hl +
          ' · <button type="button" id="ad-showall" class="underline hover:text-terracotta-dark">' + sa + '</button>';
        (notice as HTMLElement).hidden = false;
        const btn = document.getElementById('ad-showall');
        if (btn) btn.addEventListener('click', () => setProfile('audhd'));
      } else {
        (notice as HTMLElement).hidden = true;
        notice.textContent = '';
      }
    }

    document.querySelectorAll('[data-lens]').forEach((el) => {
      const lp = el.getAttribute('data-lens');
      const relevant = !!lp && set.includes(lp);
      el.classList.toggle('ad-lens-active', relevant);
      el.classList.toggle('ad-lens-dim', !relevant);
    });
  }

  function setProfile(profile: string) {
    try { localStorage.setItem('audhd-profile', profile); } catch (e) {}
    applyProfile(profile);
  }

  function initProfile() {
    let profile = 'audhd';
    const q = new URL(window.location.href).searchParams.get('profile');
    if (q && PROFILES.includes(q)) {
      profile = q;
    } else {
      try {
        const saved = localStorage.getItem('audhd-profile');
        if (saved && PROFILES.includes(saved)) profile = saved;
      } catch (e) {}
    }
    const root = document.getElementById('ad-profiles');
    if (root) {
      root.querySelectorAll('.ad-chip').forEach((c) => {
        c.addEventListener('click', () => setProfile(c.getAttribute('data-profile') || 'audhd'));
      });
    }
    applyProfile(profile);
  }

  initProfile();
</script>
